POSTGRES_USER=casovi
POSTGRES_PASSWORD=casovi
POSTGRES_DB=casovi
POSTGRES_PORT=5436
SERVER_PORT=8080
ADMINER_PORT=8082
CORS_ORIGINS=http://localhost:8081
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
DEMO_PASSWORD=casovi-demo
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Email. With an empty key the server only writes emails to its log.
# With a key from resend.com every email goes to MAIL_TO, the address you opened the Resend account with.
RESEND_API_KEY=
MAIL_TO=
DATABASE_URL=postgres://casovi:casovi@localhost:5436/casovi?sslmode=disable
